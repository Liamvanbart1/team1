<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kunstbeoordeling</title>
    <link rel="stylesheet" href="style.css">
</head>


<body class="accountBody">
    <header>
        <img src="./svg/logo-pantheon.svg">
    </header>
    <main>
        <h2 class="accountH2">Welcome, <%= users.username %> !</h2>

        <div class="form">
            <label>Username:</label>
            <p>
                <%= users.username %>
            </p>
            <label>Password:</label>
            <!-- <p class="labelP">Password:</p> -->
            <p>******** </p>
            <label>Email:</label>
            <p>
                <%= users.email %>
            </p>
            <label>Phonenumber:</label>
            <p>
                <%= users.phonenumber %>
            </p>
        </div>

        <!-- Logout button -->
        <div class="form">
            <form action="/logout" method="GET">
                <button type="submit" class="logoutbutton">Logout</button>
            </form>
        </div>
    </main>

    <form action="/edit/<%= users._id %>" method="POST">
        <label for="name">Name:</label>
        <input type="text" id="name" name="username" value="<%= users.username %>">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="<%= users.email %>">
        <button type="submit">Update</button>
    </form>
    <nav>
        <ul class="navigation">
            <li><a href="/home"><img src="./svg/painting-nonactive.svg" /><span></span></a></li>
            <li><a href="/likes"><img src="./svg/thumb-nav-unactive.svg" /><span></span></a></li>
            <li><a href="/musea"><img src="./svg/pantheon-nav.svg" /><span></span></a></li>
            <li class="active"><a href="/account"><img src="./svg/account-active.svg" /><span></span></a></li>
        </ul>
    </nav>
</body>

</html>