<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kunstbeoordeling</title>
    <link rel="stylesheet" href="style.css">
</head>

<body class="accountBody">
    <header>
        <img src="./svg/logopantheon.svg">
    </header>
    <main>
        <h2 class="accountH2">Welcome, <%= users.username %> !</h2>

        <!-- Edit button to toggle form -->
        <button id="editButton">
            <img src="./svg/edit.svg" alt="Edit">
        </button>

        <div class="accountDetails">
            <div class="form">
                <label>Username:</label>
                <p><%= users.username %></p>
                <label>Password:</label>
                <!-- <p class="labelP">Password:</p> -->
                <p>********</p>
                <label>Email:</label>
                <p><%= users.email %></p>
                <label>Phonenumber:</label>
                <p><%= users.phonenumber %></p>
            </div>
        </div>

        <!-- Logout button -->
        <div class="form" id="logoutForm">
            <form action="/logout" method="GET">
                <button type="submit" class="logoutbutton">Logout</button>
            </form>
        </div>
    </main>

    <!-- Form for updating account details (initially hidden) -->
    <form class="form">
    <div class="editFormContainer" style="display: none;">
        <form id="editForm" action="/edit/<%= users._id %>" method="POST">
            <label for="name">Name:</label>
            <input type="text" id="name" name="username" value="<%= users.username %>">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" value="<%= users.email %>">
            <label for="name">Phonenumber:</label>
            <input type="tel" id="name" name="phonenumber" value="<%= users.phonenumber %>">
            <button type="submit" class="editButton">Update</button>
        </form>
    </div>
    </form>

    <nav>
        <ul class="navigation">
            <li><a href="/home"><img src="./svg/painting-nonactive.svg" /><span></span></a></li>
            <li><a href="/likes"><img src="./svg/thumb-nav-unactive.svg" /><span></span></a></li>
            <li><a href="/musea"><img src="./svg/pantheon-nav.svg" /><span></span></a></li>
            <li class="active"><a href="/account"><img src="./svg/account-active.svg" /><span></span></a></li>
        </ul>
    </nav>
    <script src="accountedit.js"></script>
</body>

</html>
